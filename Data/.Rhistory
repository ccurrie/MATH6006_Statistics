(1-cumulative_prob)/2
# 7. Check hypothesis test
t_value <- 3.377815 #5.81954
df <- 5
# Cumulative probability
cumulative_prob <- pt(t_value, df, lower.tail = TRUE)
(1-cumulative_prob)/2
x_vals <- c(0, 10, 20,30, 40, 50, 60)
y_vals <- c(5.48, 10.37, 12.36, 11.14, 10.88, 12.28, 16.04)
data <- data.frame(x = x_vals, y = y_vals)
# 2. Fit the linear regression model (y as a function of x)
model <- lm(y ~ x, data = data)
# 3. View the summary of the model (intercept, slope, p-values, R-squared)
summary(model)
# 4. Extract coefficients (Intercept and Slope)
coef(model)
# 5. ANOVA table
anova_table <- anova(model)
print(anova_table)
# 5. Predict new values or fitted values
predictions <- predict(model, newdata = data)
# 6. Plot the data points and the regression line
plot(data$x, data$y, main = "Linear Regression", xlab = "X", ylab = "Y", pch = 19)
abline(model, col = "red", lwd = 2)
# 7. Check hypothesis test
t_value <- 3.377815 #5.81954
df <- 5
# Cumulative probability
cumulative_prob <- pt(t_value, df, lower.tail = TRUE)
(1-cumulative_prob)/2
