equipment <- readLines("store.txt")
head(equipment)
equipment_df <- read.table(
"store.txt",
header = TRUE,
sep = "\t"
)
ggplot(equipment_df, aes(x=No..of.Commercials, y=Sales.Volume)) +
geom_point() +
labs(
title = "Commercials vs Sales Volume",
x = "Number of Commercials",
y = "Sales Volume"
)
#Draw scatterplot`
ggplot(equipment_df, aes(x=`No..of.Commercials`, y=`Sales.Volume`)) +
geom_point() +
labs(
title = "Commercials vs Sales Volume",
x = "Number of Commercials",
y = "Sales Volume"
)
ggplot(equipment_df, aes(x=`No..of.Commercials`, y=`Sales.Volume`)) +
geom_point()  +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = "Commercials vs Sales Volume",
x = "Number of Commercials",
y = "Sales Volume"
)
waiting_df <- read.table(
"WaitingTimes.txt",
header = TRUE,
sep = "\t"
)
waiting_df <- read.table(
"WaitingTime.txt",
header = TRUE,
sep = "\t"
)
ggplot(waiting_df, aes(y=Waiting.Time)) +
boxplot() +
labs(
title = "Box Plot of Waiting Times",
y = "Waiting Time"
)
ggplot(waiting_df, aes(x=Waiting.Time)) +
boxplot() +
labs(
title = "Box Plot of Waiting Times",
y = "Waiting Time"
)
#Draw boxplot
ggplot(waiting_df, aes(y=`Waiting Time`)) +
geom_boxplot() +
labs(
title = "Box Plot of Waiting Times",
y = "Waiting Time"
)
ggplot(waiting_df, aes(y=Waiting.Time)) +
geom_boxplot() +
labs(
title = "Box Plot of Waiting Times",
y = "Waiting Time"
)
ggplot(waiting_df, aes(x = Waiting.Time)) +
geom_histogram(
bins = 10,
fill = "limegreen",
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(waiting_df$Waiting.Time),
sd = sd(waiting_df$Waiting.Time)
),
colour = "blue",
linewidth = 1
) +
labs(
x = "Waiting times",
y = "Density"
)
ggplot(waiting_df, aes(x = Waiting.Time)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 10,
fill = "limegreen",
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(waiting_df$Waiting.Time),
sd = sd(waiting_df$Waiting.Time)
),
colour = "blue",
linewidth = 1
) +
labs(
x = "Waiting times",
y = "Density"
)
ggplot(waiting_df, aes(x = Waiting.Time)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 15,
fill = "limegreen",
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(waiting_df$Waiting.Time),
sd = sd(waiting_df$Waiting.Time)
),
colour = "blue",
linewidth = 1
) +
labs(
x = "Waiting times",
y = "Density"
)
ggplot(waiting_df, aes(x = Waiting.Time)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 12,
fill = "limegreen",
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(waiting_df$Waiting.Time),
sd = sd(waiting_df$Waiting.Time)
),
colour = "blue",
linewidth = 1
) +
labs(
x = "Waiting times",
y = "Density"
)
#Draw a histogram with a normal curve superimposed
ggplot(waiting_df, aes(x = Waiting.Time)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 13,
fill = "limegreen",
) +
stat_function(
fun = dnorm,
args = list(
mean = mean(waiting_df$Waiting.Time),
sd = sd(waiting_df$Waiting.Time)
),
colour = "blue",
linewidth = 1
) +
